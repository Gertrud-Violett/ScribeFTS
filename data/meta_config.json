{
  "scan_directories": [
    "."
  ],
  "file_extensions": [
    ".pdf"
  ],
  "fields": [
    {
      "name": "title",
      "type": "text",
      "required": true,
      "default": ""
    },
    {
      "name": "authors",
      "type": "text",
      "required": false,
      "default": ""
    },
    {
      "name": "genre",
      "type": "choice",
      "required": false,
      "default": "",
      "choices": [
        "Rotordynamics",
        "Bearings",
        "Compressor",
        "Turbine",
        "Manufacturing",
        "Fluid Dynamics",
        "Materials",
        "NVH",
        "Other",
        "105_CryogenicPump",
        "402_Statistics"
      ]
    },
    {
      "name": "year",
      "type": "text",
      "required": false,
      "default": ""
    },
    {
      "name": "keywords",
      "type": "list",
      "required": false,
      "default": []
    },
    {
      "name": "notes",
      "type": "text",
      "required": false,
      "default": ""
    }
  ]
}